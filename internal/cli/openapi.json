{
  "openapi": "3.1.0",
  "info": {
    "title": "cuppa API",
    "version": "v1",
    "description": "Watercooler questions from a self-hosted cuppa serve. Every reply is JSON: {data, meta} on success, {error: {code, message}} on failure. New fields may be added; ignore fields you don't know.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/v1/questions/random": {
      "get": {
        "summary": "A random question",
        "operationId": "randomQuestion",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only these categories, comma separated. Replaces the config's categories.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only questions with one of these tags, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sfw",
            "in": "query",
            "required": false,
            "description": "safe (any workplace) or casual (adds lighter questions).",
            "schema": {
              "type": "string",
              "enum": [
                "safe",
                "casual"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Only this locale, like en.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only these question types, comma separated.",
            "schema": {
              "type": "string",
              "example": "open,poll"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Question"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is wrong (bad_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No question matches the filter (no_match).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/questions/today": {
      "get": {
        "summary": "The question of the day",
        "description": "Everyone using the same seed gets the same question on the same day, in the config's timezone.",
        "operationId": "todayQuestion",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only these categories, comma separated. Replaces the config's categories.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only questions with one of these tags, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sfw",
            "in": "query",
            "required": false,
            "description": "safe (any workplace) or casual (adds lighter questions).",
            "schema": {
              "type": "string",
              "enum": [
                "safe",
                "casual"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Only this locale, like en.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only these question types, comma separated.",
            "schema": {
              "type": "string",
              "example": "open,poll"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "description": "Defaults to selection.seed from the config.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Question"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is wrong (bad_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No question matches the filter (no_match).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/questions/next": {
      "get": {
        "summary": "The next question not used yet",
        "description": "Saves the question to the history, so it won't come again until every question was used. Needs the token when server.token is set.",
        "operationId": "nextQuestion",
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only these categories, comma separated. Replaces the config's categories.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only questions with one of these tags, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sfw",
            "in": "query",
            "required": false,
            "description": "safe (any workplace) or casual (adds lighter questions).",
            "schema": {
              "type": "string",
              "enum": [
                "safe",
                "casual"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Only this locale, like en.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only these question types, comma separated.",
            "schema": {
              "type": "string",
              "example": "open,poll"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Question"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is wrong (bad_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No question matches the filter (no_match).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token (unauthorized).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/questions/{id}": {
      "get": {
        "summary": "One question by id",
        "operationId": "getQuestion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "tot-0001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Question"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No question with that id (not_found).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/questions": {
      "get": {
        "summary": "List questions",
        "description": "Questions the config's selection allows, narrowed by the filters. meta has total, limit and offset.",
        "operationId": "listQuestions",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only these categories, comma separated. Replaces the config's categories.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only questions with one of these tags, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sfw",
            "in": "query",
            "required": false,
            "description": "safe (any workplace) or casual (adds lighter questions).",
            "schema": {
              "type": "string",
              "enum": [
                "safe",
                "casual"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Only this locale, like en.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only these question types, comma separated.",
            "schema": {
              "type": "string",
              "example": "open,poll"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1-1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Questions to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Question"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is wrong (bad_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/categories": {
      "get": {
        "summary": "List categories",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/post": {
      "post": {
        "summary": "Pick a question and post it",
        "description": "Works like cuppa post. Needs server.token to be set (and sent), unless cuppa serve was started with --insecure-allow-post. At most 10 posts a minute per client. 200 means at least one target got it: compare posted with targets.",
        "operationId": "post",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": false,
            "description": "Post to this target only. Default: every target.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PostResult"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token (unauthorized).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Posting is turned off: no server.token (post_disabled).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No target with that name (not_found), or no question matches (no_match).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many posts (rate_limited).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The config can't post (config_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "No target accepted the post (post_failed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "The server is running",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Questions are loaded",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "cuppa and dataset versions",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "commit": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "questions": {
                          "type": "integer"
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The server.token from the config."
      }
    },
    "schemas": {
      "Question": {
        "type": "object",
        "required": [
          "id",
          "category",
          "text",
          "type",
          "sfw",
          "locale",
          "added"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "tot-0001",
            "description": "Never changes or gets reused."
          },
          "category": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "open",
              "poll",
              "this-or-that"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Poll and this-or-that answers."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfw": {
            "type": "string",
            "enum": [
              "safe",
              "casual"
            ]
          },
          "locale": {
            "type": "string",
            "example": "en"
          },
          "added": {
            "type": "string",
            "format": "date"
          },
          "author": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "PostResult": {
        "type": "object",
        "required": [
          "question",
          "posted",
          "targets"
        ],
        "properties": {
          "question": {
            "$ref": "#/components/schemas/Question"
          },
          "posted": {
            "type": "integer",
            "description": "Targets that got the question."
          },
          "targets": {
            "type": "integer",
            "description": "Targets tried."
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "dataset_version",
          "api_version"
        ],
        "properties": {
          "dataset_version": {
            "type": "string"
          },
          "api_version": {
            "type": "string",
            "const": "v1"
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "not_found",
                  "no_match",
                  "unauthorized",
                  "post_disabled",
                  "rate_limited",
                  "config_error",
                  "post_failed",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
